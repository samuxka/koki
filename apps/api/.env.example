PORT=3333
NODE_ENV=development
# MongoDB URI - insira a string de conexão do MongoDB Atlas
MONGODB_USERNAME=seu_usuario
MONGODB_PASSWORD=sua_senha
MONGODB_URI=mongodb+srv://<usuario>:<senha>@koki.q5u2qbb.mongodb.net/koki?retryWrites=true&w=majority
JWT_SECRET=koki-super-secret-jwt-key-2026-production-ready
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SAAS_PRODUCT_ID=koki
SAAS_PRODUCT_NAME=Koki
CORS_ORIGIN=*
